# Local development. Copy to `.env` and paste the key from `supabase status`.
#
# This is the only env file you need. `npm run dev` always talks to local
# Supabase. To point at Supabase Cloud instead, see .env.cloud.example — that is
# a deliberate, separate command (`npm run dev:cloud`), never a file that
# silently redirects `npm run dev` at production.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=<paste publishable key from `supabase status`>
# Sentry DSN — production builds only. Leave unset locally; the SDK no-ops
# without it. Source-map upload also needs SENTRY_AUTH_TOKEN, SENTRY_ORG,
# SENTRY_PROJECT at build time (set in deploy-pages.yml from GitHub secrets,
# never in this file).
VITE_SENTRY_DSN=
