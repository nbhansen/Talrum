# Pointing local dev at Supabase Cloud. Copy to `.env.cloud`, then run:
#
#   npm run dev:cloud
#
# Loaded only by that command (`vite --mode cloud`). `npm run dev` never reads
# it, so you cannot end up writing to a real project without typing `dev:cloud`
# in this session. The dev server prints which project it is talking to on boot.
#
# WARNING: these writes hit a real project with real user data. There is no
# staging project (#98).
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable key from dashboard → Project Settings → API>
