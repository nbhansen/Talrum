# Local secrets for generate-voice and generate-image. Copy to `.env.local`.
# Then: supabase functions serve --env-file supabase/functions/.env.local
# Without them each function answers `not_configured`.
# docs/runbooks/deploy.md tells where each value comes from.
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=
AZURE_OPENAI_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_IMAGE_DEPLOYMENT=
